# Server Port
PORT=8080

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/kb_db?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_32_bytes
JWT_EXPIRATION_MS=86400000

# Open API Key
YOUTH_POLICY_API_KEY=your_youth_policy_api_key_here